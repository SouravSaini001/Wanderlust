<% layout("partials/boilerplate") %>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-body p-4 p-md-5">

                    <div class="mb-4">
                        <a
                            href="/listings/<%= listing._id %>"
                            class="text-decoration-none"
                        >
                            ← Back to listing
                        </a>
                    </div>

                    <h2 class="fw-bold mb-2">
                        Edit Your Booking
                    </h2>

                    <p class="text-muted mb-4">
                        Update your stay details before payment.
                    </p>

                    <div class="alert alert-info rounded-3">
                        <strong>
                            Booking hold active
                        </strong>
                        <br>
                        Your current booking remains temporarily reserved.
                    </div>

                    <form
                        action="/book/<%= booking._id %>?_method=PUT"
                        method="POST"
                    >

                        <!-- CHECK-IN -->

                        <div class="mb-3">

                            <label
                                for="checkIn"
                                class="form-label fw-semibold"
                            >
                                Check-in
                            </label>

                            <input
                                type="date"
                                id="checkIn"
                                name="checkIn"
                                class="form-control"
                                value="<%= booking.checkIn.toISOString().split('T')[0] %>"
                                required
                            >

                        </div>

                        <!-- CHECK-OUT -->

                        <div class="mb-3">

                            <label
                                for="checkOut"
                                class="form-label fw-semibold"
                            >
                                Check-out
                            </label>

                            <input
                                type="date"
                                id="checkOut"
                                name="checkOut"
                                class="form-control"
                                value="<%= booking.checkOut.toISOString().split('T')[0] %>"
                                required
                            >

                        </div>

                        <!-- ROOMS -->

                        <div class="mb-3">

                            <label
                                for="rooms"
                                class="form-label fw-semibold"
                            >
                                Rooms
                            </label>

                            <input
                                type="number"
                                id="rooms"
                                name="rooms"
                                class="form-control"
                                min="1"
                                max="<%= listing.rooms %>"
                                value="<%= booking.rooms %>"
                                required
                            >

                            <small class="text-muted">
                                Maximum available rooms:
                                <%= listing.rooms %>
                            </small>

                        </div>

                        <!-- GUESTS -->

                        <div class="mb-4">

                            <label
                                for="guests"
                                class="form-label fw-semibold"
                            >
                                Guests
                            </label>

                            <input
                                type="number"
                                id="guests"
                                name="guests"
                                class="form-control"
                                min="1"
                                value="<%= booking.guests %>"
                                required
                            >

                            <small class="text-muted">
                                Maximum 2 guests per room.
                            </small>

                        </div>

                        <!-- BUTTONS -->

                        <div class="d-grid gap-2">

                            <button
                                type="submit"
                                class="btn btn-primary btn-lg rounded-3"
                            >
                                <i class="fa-solid fa-pen-to-square me-2"></i>
                                Update Booking
                            </button>

                            <a
                                href="/book/<%= booking._id %>/confirm"
                                class="btn btn-outline-secondary rounded-3"
                            >
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>