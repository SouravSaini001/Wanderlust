<% layout("partials/boilerplate") %>

<div class="row mt-5">

    <div class="col-md-6 offset-md-3">

        <h2 class="text-center mb-4">
            Create New Password
        </h2>

        <form action="/reset-password" method="POST">

            <div class="mb-3">

                <label
                    for="password"
                    class="form-label"
                >
                    New Password
                </label>

                <input
                    type="password"
                    id="password"
                    name="password"
                    class="form-control"
                    minlength="8"
                    required
                >

            </div>


            <div class="mb-3">

                <label
                    for="confirmPassword"
                    class="form-label"
                >
                    Confirm New Password
                </label>

                <input
                    type="password"
                    id="confirmPassword"
                    name="confirmPassword"
                    class="form-control"
                    minlength="8"
                    required
                >

            </div>


            <button
                type="submit"
                class="btn btn-danger w-100"
            >
                Change Password
            </button>

        </form>

    </div>

</div>