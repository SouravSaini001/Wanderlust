<% layout("partials/boilerplate") %>

<div class="row mt-5">

    <div class="col-md-6 offset-md-3">

        <h2 class="text-center mb-3">
            Verify Your Email
        </h2>

        <p class="text-center text-muted">
            We have sent a 6-digit OTP to your email.
        </p>


        <form
            action="/verify-otp"
            method="POST"
        >

            <div class="mb-3">

                <label
                    for="otp"
                    class="form-label"
                >
                    Enter OTP
                </label>

                <input
                    type="text"
                    id="otp"
                    name="otp"
                    class="form-control text-center"
                    placeholder="Enter 6 digit OTP"
                    maxlength="6"
                    pattern="[0-9]{6}"
                    required
                >

            </div>


            <button
                type="submit"
                class="btn btn-danger w-100"
            >
                Verify OTP
            </button>

        </form>


        <form
            action="/resend-otp"
            method="POST"
            class="mt-3"
        >

            <button
                type="submit"
                class="btn btn-outline-secondary w-100"
            >
                Resend OTP
            </button>

        </form>

    </div>

</div>