<% layout("partials/boilerplate") %>

<div class="auth-page">
    <div class="auth-container">

        <div class="auth-card">

            <!-- Header -->
            <div class="auth-header">

                <div class="auth-icon">
                    <i class="fa-solid fa-key"></i>
                </div>

                <h1>Verify OTP</h1>

                <p>
                    We have sent a 6-digit OTP to your registered email.
                </p>

            </div>


            <!-- Verify Reset OTP -->
            <form
                action="/verify-reset-otp"
                method="POST"
                class="auth-form needs-validation"
                novalidate
            >

                <div class="auth-form-group">

                    <label
                        for="otp"
                        class="form-label"
                    >
                        Enter OTP
                    </label>

                    <div class="auth-input-wrapper">

                        <i class="fa-solid fa-shield-halved"></i>

                        <input
                            type="text"
                            id="otp"
                            name="otp"
                            class="form-control auth-input otp-input"
                            placeholder="Enter 6-digit OTP"
                            maxlength="6"
                            pattern="[0-9]{6}"
                            inputmode="numeric"
                            autocomplete="one-time-code"
                            required
                        >

                    </div>

                    <div class="invalid-feedback">
                        Please enter a valid 6-digit OTP.
                    </div>

                </div>


                <!-- Verify Button -->
                <button
                    type="submit"
                    class="auth-submit-btn"
                >
                    <i class="fa-solid fa-circle-check"></i>
                    Verify OTP
                </button>

            </form>


            <!-- Resend OTP -->
            <form
                action="/resend-reset-otp"
                method="POST"
                class="otp-resend-form"
            >

                <p>
                    Didn't receive the code?
                </p>

                <button
                    type="submit"
                    class="otp-resend-btn"
                >
                    <i class="fa-solid fa-rotate-right"></i>
                    Resend OTP
                </button>

            </form>


            <!-- Back to Login -->
            <div class="auth-footer">

                <span>Back to</span>

                <a href="/login">
                    Login
                </a>

            </div>

        </div>

    </div>
</div>

