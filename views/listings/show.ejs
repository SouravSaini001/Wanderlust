<% layout('partials/boilerplate.ejs') %>

  <script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const coordinate = <%- JSON.stringify(listing.geometry.coordinates) %>;
  </script>

  <!-- =========================================================
     LISTING DETAILS
========================================================= -->

  <section class="listing-show-page">
    <div class="listing-show-container">

      <!-- Listing Image -->
      <div class="listing-show-image-section">
        <div class="listing-show-image-card">
          <img src="<%= listing.image.url %>" alt="<%= listing.title %>" class="listing-show-image">
        </div>
      </div>

      <!-- Listing Details -->
      <div class="listing-show-details-section">
        <div class="listing-details-card">

          <!-- Location -->
          <div class="listing-location-label">
            <i class="fa-solid fa-location-dot"></i>
            <span>
              <%= listing.location %>, <%= listing.country %>
            </span>
          </div>

          <!-- Title -->
          <h1 class="listing-show-title">
            <%= listing.title %>
          </h1>
          <!-- Owner  -->
          <div class="listing-owner">
            <div class="owner-icon">
              <i class="fa-solid fa-user"></i>
            </div>

            <div>
              <span class="owner-label">Hosted by</span>

              <strong>
                <% if (listing.owner && listing.owner.username) { %>
                  <%= listing.owner.username %>
                    <% } else if (listing.owner && listing.owner.email) { %>
                      <%= listing.owner.email.split("@")[0] %>
                        <% } else { %>
                          Wanderlust Host
                          <% } %>
              </strong>
            </div>
          </div>

          <div class="listing-divider"></div>

          <!-- Description -->
          <p class="listing-show-description">
            <%= listing.description %>
          </p>

          <!-- Price -->
          <div class="listing-price-box">
            <span class="listing-show-price">
              ₹<%= listing.price.toLocaleString("en-IN") %>
            </span>

            <span class="listing-price-period">
              / night
            </span>
          </div>

          <a href="/book/<%= listing._id %>" class="btn btn-dark">
            <i class="fa-solid fa-calendar-check me-1"></i>
            Book Now
          </a>

          <!-- Owner Actions -->
          <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>

            <div class="listing-owner-actions">

              <a href="/listings/<%= listing._id %>/edit" class="listing-edit-btn">
                <i class="fa-regular fa-pen-to-square"></i>
                Edit listing
              </a>

              <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                <button class="listing-delete-btn" type="submit">
                  <i class="fa-regular fa-trash-can"></i>
                  Delete
                </button>
              </form>

            </div>

            <% } %>

        </div>
      </div>

    </div>

  </section>

  <!-- =========================================================
     REVIEW FORM
========================================================= -->

  <% if (currUser) { %>

    <section class="review-section">

      <div class="review-form-card">

        <!-- Section Heading -->
        <div class="section-heading">

          <span class="section-heading-icon">
            <i class="fa-regular fa-star"></i>
          </span>

          <div>
            <h2>Share your experience</h2>
            <p>Your review helps other travelers.</p>
          </div>

        </div>


        <!-- Review Form -->
        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>

          <!-- Rating -->
          <div class="review-rating-box">

            <label class="form-label">
              How was your stay?
            </label>

            <fieldset class="starability-slot">

              <input type="radio" id="first-rate1" name="review[rating]" value="1">
              <label for="first-rate1" title="Terrible">
                1 star
              </label>


              <input type="radio" id="first-rate2" name="review[rating]" value="2">
              <label for="first-rate2" title="Not good">
                2 stars
              </label>


              <input type="radio" id="first-rate3" name="review[rating]" value="3">
              <label for="first-rate3" title="Average">
                3 stars
              </label>


              <input type="radio" id="first-rate4" name="review[rating]" value="4">
              <label for="first-rate4" title="Very good">
                4 stars
              </label>


              <input type="radio" id="first-rate5" name="review[rating]" value="5" checked>
              <label for="first-rate5" title="Amazing">
                5 stars
              </label>

            </fieldset>

          </div>


          <!-- Comment -->
          <div class="mb-4">

            <label for="comment" class="form-label">
              Your comment
            </label>

            <textarea name="review[comment]" id="comment" rows="5" class="form-control review-textarea"
              placeholder="Tell other travelers about your experience..." required></textarea>

            <div class="invalid-feedback">
              Please write a comment.
            </div>

          </div>


          <!-- Submit -->
          <button type="submit" class="review-submit-btn">
            <i class="fa-regular fa-paper-plane"></i>
            Submit review
          </button>

        </form>

      </div>

    </section>

    <% } %>

      <!-- =========================================================
     REVIEWS
========================================================= -->

      <section class="reviews-section">

        <div class="reviews-card">

          <!-- Section Heading -->
          <div class="section-heading">

            <span class="section-heading-icon">
              <i class="fa-regular fa-comments"></i>
            </span>

            <div>

              <h2>Guest reviews</h2>

              <p>
                <% if (listing.reviews.length===0) { %>

                  No reviews yet

                  <% } else { %>

                    <%= listing.reviews.length %>
                      <%= listing.reviews.length===1 ? "review" : "reviews" %>

                        <% } %>
              </p>

            </div>

          </div>


          <!-- Empty Reviews -->
          <% if (listing.reviews.length===0) { %>

            <div class="empty-reviews">

              <div class="empty-reviews-icon">
                <i class="fa-regular fa-comment-dots"></i>
              </div>

              <h3>No reviews yet</h3>

              <p>
                Be the first guest to share your experience.
              </p>

            </div>


            <!-- Reviews List -->
            <% } else { %>

              <div class="reviews-list">

                <% listing.reviews.forEach(review=> { %>

                  <article class="review-item">

                    <!-- Review Header -->
                    <div class="review-top">

                      <div class="review-user">

                        <div class="review-avatar">
                          <i class="fa-solid fa-user"></i>
                        </div>

                        <div>

                          <strong>
                            <%= review.author.username %>
                          </strong>

                          <!-- Stars -->
                          <div class="review-stars">

                            <% for (let i=1; i <=5; i++) { %>

                              <% if (i <=review.rating) { %>

                                <i class="fa-solid fa-star"></i>

                                <% } else { %>

                                  <i class="fa-regular fa-star"></i>

                                  <% } %>

                                    <% } %>

                          </div>

                        </div>

                      </div>


                      <!-- Rating Number -->
                      <span class="review-rating-number">
                        <%= review.rating %>/5
                      </span>

                    </div>


                    <!-- Review Comment -->
                    <p class="review-comment">
                      <%= review.comment %>
                    </p>


                    <!-- Delete Review -->
                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST"
                      class="review-delete-form">

                      <button class="review-delete-btn" type="submit">
                        <i class="fa-regular fa-trash-can"></i>
                        Delete
                      </button>

                    </form>

                  </article>

                  <% }) %>

              </div>

              <% } %>

        </div>

      </section>

      <!-- =========================================================
     MAP
========================================================= -->

      <section class="map-section">

        <div class="map-card">

          <!-- Map Heading -->
          <div class="section-heading">

            <span class="section-heading-icon">
              <i class="fa-solid fa-location-dot"></i>
            </span>

            <div>

              <h2>Where you'll be</h2>

              <p>
                <%= listing.location %>, <%= listing.country %>
              </p>

            </div>

          </div>


          <!-- Mapbox -->
          <div id="map"></div>

        </div>

      </section>

      <script src="/js/map.js"></script>