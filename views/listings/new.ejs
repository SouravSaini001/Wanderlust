<% layout("partials/boilerplate.ejs") %>

  <div class="new-listing-page">

    <!-- Page Header -->
    <div class="new-listing-header">
      <span class="new-listing-eyebrow">
        <i class="fa-solid fa-house"></i>
        Wanderlust Hosting
      </span>

      <h1>Create a New Listing</h1>

      <p>
        Share your beautiful place and help travelers discover their next stay.
      </p>
    </div>

    <!-- Form Card -->
    <div class="new-listing-card">

      <form action="/listings" method="POST" class="needs-validation" novalidate enctype="multipart/form-data">

        <!-- Title -->
        <div class="form-section">
          <label for="title" class="form-label">
            Listing title
          </label>

          <input type="text" id="title" name="listing[title]" placeholder="e.g. Luxury Beach Villa in Goa"
            class="form-control" required>

          <div class="valid-feedback">
            Looks good!
          </div>

          <div class="invalid-feedback">
            Please enter a title.
          </div>
        </div>


        <!-- Description -->
        <div class="form-section">
          <label for="description" class="form-label">
            Description
          </label>

          <textarea id="description" name="listing[description]"
            placeholder="Tell guests what makes your place special..." class="form-control" rows="5"
            required></textarea>

          <div class="valid-feedback">
            Looks good!
          </div>

          <div class="invalid-feedback">
            Please enter a description.
          </div>
        </div>


        <!-- Image -->
        <div class="form-section">
          <label for="image" class="form-label">
            Listing image
          </label>

          <div class="image-upload-box">

            <div class="image-upload-icon">
              <i class="fa-regular fa-image"></i>
            </div>

            <div class="image-upload-content">
              <strong>Upload a beautiful photo</strong>
              <span>JPG, JPEG, PNG or WEBP</span>
            </div>

            <input type="file" id="image" name="listing[image]" class="form-control" accept="image/*" required>

          </div>

          <div class="invalid-feedback">
            Please upload a listing image.
          </div>
        </div>


        <!-- Category -->
        <div class="form-section">
          <label for="category" class="form-label">
            Category
          </label>

          <select name="listing[category]" id="category" class="form-select" required>
            <option value="">Choose a category</option>
            <option value="Trending">Trending</option>
            <option value="Rooms">Rooms</option>
            <option value="Iconic Cities">Iconic Cities</option>
            <option value="Surfing">Surfing</option>
            <option value="Beach">Beach</option>
            <option value="Amazing Pools">Amazing Pools</option>
            <option value="Mountain">Mountain</option>
            <option value="Farms">Farms</option>
            <option value="Camping">Camping</option>
            <option value="Castles">Castles</option>
          </select>

          <div class="valid-feedback">
            Looks good!
          </div>

          <div class="invalid-feedback">
            Please select a category.
          </div>
        </div>


        <!-- Price -->
        <div class="form-section">
          <label for="price" class="form-label">
            Price per night
          </label>

          <div class="price-input-wrapper">
            <span class="currency-symbol">₹</span>

            <input type="number" id="price" name="listing[price]" placeholder="2500" class="form-control price-input"
              min="0" required>
          </div>

          <div class="valid-feedback">
            Looks good!
          </div>

          <div class="invalid-feedback">
            Please enter a valid price.
          </div>
        </div>

        <!-- Input for no of rooms have  -->

        <div class="mb-3">
          <label for="rooms" class="form-label">Number of Rooms</label>

          <input type="number" name="listing[rooms]" id="rooms" class="form-control" min="1" step="1"
            placeholder="e.g. 10" required>

          <div class="form-text">
            Enter the total number of rooms available at this property.
          </div>
        </div>


        <!-- Country + Location -->
        <div class="row g-3">

          <div class="col-md-5">
            <div class="form-section">
              <label for="country" class="form-label">
                Country
              </label>

              <input type="text" id="country" name="listing[country]" placeholder="India" class="form-control" required>

              <div class="invalid-feedback">
                Please enter a country.
              </div>
            </div>
          </div>


          <div class="col-md-7">
            <div class="form-section">
              <label for="location" class="form-label">
                Location
              </label>

              <input type="text" id="location" name="listing[location]" placeholder="Goa, India" class="form-control"
                required>

              <div class="invalid-feedback">
                Please enter a location.
              </div>
            </div>
          </div>

        </div>


        <!-- Submit -->
        <div class="new-listing-submit">

          <button type="submit" class="create-listing-btn">
            <i class="fa-solid fa-plus"></i>
            Create Listing
          </button>

          <a href="/listings" class="cancel-listing-btn">
            Cancel
          </a>

        </div>

      </form>

    </div>

  </div>