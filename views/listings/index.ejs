<% layout("partials/boilerplate.ejs") %>

    <!-- =========================================================
     CATEGORY FILTERS
     ========================================================= -->

    <div class="listing-toolbar">

        <!-- Category Filters -->
        <div id="filters">

            <!-- Trending -->
            <a href="/listings?category=Trending" class="filter">
                <i class="fa-solid fa-fire"></i>
                <span>Trending</span>
            </a>

            <!-- Rooms -->
            <a href="/listings?category=Rooms" class="filter">
                <i class="fa-solid fa-bed"></i>
                <span>Rooms</span>
            </a>

            <!-- Iconic Cities -->
            <a href="/listings?category=Iconic%20Cities" class="filter">
                <i class="fa-solid fa-city"></i>
                <span>Iconic Cities</span>
            </a>

            <!-- Surfing -->
            <a href="/listings?category=Surfing" class="filter">
                <i class="fa-solid fa-water"></i>
                <span>Surfing</span>
            </a>

            <!-- Beach -->
            <a href="/listings?category=Beach" class="filter">
                <i class="fa-solid fa-umbrella-beach"></i>
                <span>Beach</span>
            </a>

            <!-- Amazing Pools -->
            <a href="/listings?category=Amazing%20Pools" class="filter">
                <i class="fa-solid fa-water-ladder"></i>
                <span>Amazing Pools</span>
            </a>

            <!-- Mountain -->
            <a href="/listings?category=Mountain" class="filter">
                <i class="fa-solid fa-mountain"></i>
                <span>Mountain</span>
            </a>

            <!-- Farms -->
            <a href="/listings?category=Farms" class="filter">
                <i class="fa-solid fa-cow"></i>
                <span>Farms</span>
            </a>

            <!-- Camping -->
            <a href="/listings?category=Camping" class="filter">
                <i class="fa-solid fa-campground"></i>
                <span>Camping</span>
            </a>

            <!-- Castles -->
            <a href="/listings?category=Castles" class="filter">
                <i class="fa-brands fa-fort-awesome"></i>
                <span>Castles</span>
            </a>

        </div>


        <!-- =====================================================
     TAX SWITCH
     ===================================================== -->

        <div class="tax-switch">

            <div class="form-check form-switch">

                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckReverse">

                <label class="form-check-label" for="switchCheckReverse">
                    Display total after taxes
                </label>

            </div>

        </div>

    </div>

    <!-- =========================================================
     LISTINGS
     ========================================================= -->

    <div class="listing_cards row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">

        <% for (let listing of allListings) { %>

            <div class="col">

                <a href="/listings/<%= listing.id %>" class="listing-card-link">

                    <article class="listing-card">

                        <!-- Listing Image -->
                        <div class="listing-image-wrapper">

                            <img src="<%= listing.image.url %>" class="listing-card-image" alt="<%= listing.title %>"
                                loading="lazy">

                            <!-- Favorite Button -->
                            <button type="button" class="listing-favorite" aria-label="Add to favorites"
                                onclick="event.preventDefault();">
                                <i class="fa-regular fa-heart"></i>
                            </button>

                        </div>


                        <!-- Listing Information -->
                        <div class="listing-card-body">

                            <h3 class="listing-card-title">
                                <%= listing.title %>
                            </h3>

                            <p class="listing-card-price">

                                <strong>
                                    ₹<%= listing.price.toLocaleString("en-IN") %>
                                </strong>

                                <span>
                                    night
                                </span>

                                <span class="tax-info">
                                    &nbsp; + 18% GST
                                </span>

                            </p>

                        </div>

                    </article>

                </a>

            </div>

            <% } %>

    </div>

    <!-- =========================================================
     EMPTY STATE
     ========================================================= -->

    <% if (allListings.length===0) { %>

        <div class="empty-listings">

            <div class="empty-listings-icon">
                <i class="fa-regular fa-compass"></i>
            </div>

            <h2>No listings found</h2>

            <p>
                We couldn't find any stays in this category.
                Try exploring another category.
            </p>

            <a href="/listings" class="btn empty-listings-btn">
                Explore all stays
            </a>

        </div>

        <% } %>