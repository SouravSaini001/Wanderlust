<!DOCTYPE html>
<html lang="en">

<head>

    <!-- ==========================================
         BASIC PAGE SETTINGS
    =========================================== -->

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#ffffff"
    >

    <title>Wanderlust</title>


    <!-- ==========================================
         FAVICON
    =========================================== -->

    <link
        rel="icon"
        type="image/png"
        href="/favicon-180.png"
    >


    <!-- ==========================================
         GOOGLE FONTS
    =========================================== -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Roboto+Flex:opsz,wght@8..144,100..1000&display=swap"
        rel="stylesheet"
    >


    <!-- ==========================================
         BOOTSTRAP
    =========================================== -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    >


    <!-- ==========================================
         FONT AWESOME
    =========================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css"
        integrity="sha512-DxV+EoADOkOygM4IR9yXP8Sb2qwgidEmeqAEmDKIOfPRQZOWbXCzLC6vjbZyy0vPisbH2SyW27+ddLVCN+OMzQ=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    >


    <!-- ==========================================
         WANDERLUST CUSTOM CSS
    =========================================== -->

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/rating.css"
    >


    <!-- ==========================================
         MAPBOX CSS
    =========================================== -->

    <link
        href="https://api.mapbox.com/mapbox-gl-js/v3.15.0/mapbox-gl.css"
        rel="stylesheet"
    >


    <!-- ==========================================
         MAPBOX JAVASCRIPT
    =========================================== -->

    <script
        src="https://api.mapbox.com/mapbox-gl-js/v3.15.0/mapbox-gl.js">
    </script>

</head>


<body>

    <!-- ==========================================
         NAVIGATION BAR
    =========================================== -->

    <%- include('../includes/navbar.ejs') %>


    <!-- ==========================================
         MAIN CONTENT
    =========================================== -->

    <main class="main-content">

        <div class="container">

            <!-- Flash Messages -->
            <%- include('../includes/flash.ejs') %>

            <!-- Page Content -->
            <%- body %>

        </div>

    </main>


    <!-- ==========================================
         FOOTER
    =========================================== -->

    <%- include('../includes/footer.ejs') %>


    <!-- ==========================================
         BOOTSTRAP JAVASCRIPT
    =========================================== -->

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous">
    </script>


    <!-- ==========================================
         WANDERLUST JAVASCRIPT
    =========================================== -->

    <script src="/js/script.js"></script>

</body>

</html>